+// KW Gram: when "Изменить визуально" is on and there is composed input text, long-pressing
+// the send button first offers "Текст от собеседника" / "Текст от меня" — one tap drops that
+// text into the chat as a fake incoming/outgoing message on this device (and clears the input)
+// — plus a passthrough to the stock send options. When the feature is off, or the input is
+// empty, the stock options open directly, exactly as before.
 func chatMessageDisplaySendMessageOptions(selfController: ChatControllerImpl, node: ASDisplayNode, gesture: ContextGesture) {
+    guard let peerId = selfController.chatLocation.peerId else {
+        chatMessageDisplaySendMessageOptionsReal(selfController: selfController, node: node, gesture: gesture)
+        return
+    }
+    let context = selfController.context
+    let inputText = selfController.presentationInterfaceState.interfaceState.effectiveInputState.inputText.string.trimmingCharacters(in: .whitespacesAndNewlines)
+    let _ = (KWGramCore.settingsSignal(postbox: context.account.postbox)
+    |> take(1)
+    |> deliverOnMainQueue).startStandalone(next: { [weak selfController] settings in
+        guard let selfController else {
+            return
+        }
+        guard settings.visualEditEnabled, !inputText.isEmpty else {
+            chatMessageDisplaySendMessageOptionsReal(selfController: selfController, node: node, gesture: gesture)
+            return
+        }
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let preview = inputText.count > 40 ? String(inputText.prefix(40)) + "…" : inputText
+        let clearInput: () -> Void = { [weak selfController] in
+            selfController?.interfaceInteraction?.updateTextInputStateAndMode { _, inputMode in
+                return (ChatTextInputState(inputText: NSAttributedString(string: "")), inputMode)
+            }
+        }
+        let sheet = ActionSheetController(presentationData: presentationData)
+        sheet.setItemGroups([
+            ActionSheetItemGroup(items: [
+                ActionSheetTextItem(title: "Отправить «\(preview)» как"),
+                ActionSheetButtonItem(title: "Текст от собеседника", color: .accent, action: { [weak sheet] in
+                    sheet?.dismissAnimated()
+                    kwGramInsertTextDirect(context: context, peerId: peerId, text: inputText, incoming: true)
+                    clearInput()
+                }),
+                ActionSheetButtonItem(title: "Текст от меня", color: .accent, action: { [weak sheet] in
+                    sheet?.dismissAnimated()
+                    kwGramInsertTextDirect(context: context, peerId: peerId, text: inputText, incoming: false)
+                    clearInput()
+                }),
+                ActionSheetButtonItem(title: "Обычная отправка…", color: .accent, action: { [weak sheet, weak selfController] in
+                    sheet?.dismissAnimated()
+                    if let selfController {
+                        chatMessageDisplaySendMessageOptionsReal(selfController: selfController, node: node, gesture: gesture)
+                    }
+                })
+            ]),
+            ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: presentationData.strings.Common_Cancel, color: .accent, font: .bold, action: { [weak sheet] in
+                    sheet?.dismissAnimated()
+                })
+            ])
+        ])
+        selfController.present(sheet, in: .window(.root))
+    })
+}
