new file mode 100644
index 00000000..a57d48ef
--- /dev/null
+++ b/submodules/TelegramCore/Sources/KWGram/KWGramDeletedMessageCapture.swift
@@ -0,0 +1,124 @@
+import Foundation
+import Postbox
+import KWGramCore
+
+/// Captures messages the other side deleted, before Postbox removes them, so they stay
+/// visible (dimmed, red trash badge — see the patch to `ChatMessageBubbleItemNode.swift`) in
+/// the chat instead of vanishing. Called from `replayFinalState` in
+/// `AccountStateManagementUtils.swift`, right before the real
+/// `deleteMessages`/`deleteMessagesWithGlobalIds` call that would otherwise be the only thing
+/// that ever touches these ids.
+///
+/// Lives in `TelegramCore` itself (rather than a separate mod module) on purpose: it needs
+/// `TelegramMediaAction`/`TextEntitiesMessageAttribute`/`Namespaces`, all TelegramCore types,
+/// and `KWGramCore` — which it does depend on — must never depend back on `TelegramCore`,
+/// so the reusable record/attribute/store types it calls into live there instead of here.
+enum KWGramDeletedMessageCapture {
+    /// `messageIds` must already be resolved to peer-scoped `MessageId`s — for the "global id"
+    /// deletion path (regular private chats and basic groups), resolve with
+    /// `transaction.messageIdsForGlobalIds(_:)` before calling this.
+    static func captureBeforeDelete(transaction: Transaction, accountPeerId: PeerId, messageIds: [MessageId]) {
+        let settings = KWGramCore.settings(transaction: transaction)
+        guard settings.antiDeleteMessagesEnabled else {
+            return
+        }
+        let excludedPeerIds = Set(settings.antiDeleteExcludedPeerIds)
+        let now = Int32(Date().timeIntervalSince1970)
+        for id in messageIds {
+            // Never resurrect KW Gram's own local-only rows (phantom gifts, earlier
+            // resurrections) — they're not real deletions, and re-capturing an already-local
+            // message would just duplicate it forever.
+            if id.namespace == Namespaces.Message.Local {
+                continue
+            }
+            // A chat the user picked to exclude from anti-delete entirely — left to behave
+            // like stock Telegram, deletions and all.
+            if excludedPeerIds.contains(id.peerId) {
+                continue
+            }
+            guard let message = transaction.getMessage(id) else {
+                continue
+            }
+            // Only messages the *other* side sent — a message this account's own user deleted
+            // (on this device or another) is a real, intentional delete and is left alone.
+            guard let author = message.author, author.id != accountPeerId else {
+                continue
+            }
+            // Service messages (join/leave, calls, real gift actions, etc.) aren't content the
+            // user typed or sent — nothing meaningful to resurrect.
+            if message.media.contains(where: { $0 is TelegramMediaAction }) {
+                continue
+            }
+
+            var attributes: [MessageAttribute] = message.attributes.filter { $0 is TextEntitiesMessageAttribute }
+            attributes.append(KWGramDeletedByRemoteAttribute(deletedAt: now))
+
+            let globallyUniqueId = Int64.random(in: Int64.min ... Int64.max)
+            let storeMessage = StoreMessage(
+                id: .Partial(id.peerId, Namespaces.Message.Local),
+                customStableId: nil,
+                globallyUniqueId: globallyUniqueId,
+                groupingKey: message.groupingKey,
+                threadId: message.threadId,
+                timestamp: message.timestamp,
+                flags: StoreMessageFlags(message.flags),
+                tags: message.tags,
+                globalTags: message.globalTags,
+                localTags: message.localTags,
+                forwardInfo: message.forwardInfo.map(StoreMessageForwardInfo.init),
+                authorId: author.id,
+                text: message.text,
+                attributes: attributes,
+                media: message.media
+            )
+            let insertedIds = transaction.addMessages([storeMessage], location: .Random)
+            guard let localMessageId = insertedIds[globallyUniqueId] else {
+                continue
+            }
+
+            var textPreview = message.text
+            if textPreview.isEmpty, let firstMedia = message.media.first {
+                textPreview = self.mediaPreview(firstMedia)
+            }
+            if textPreview.count > 120 {
+                textPreview = String(textPreview.prefix(120))
+            }
+
+            KWGramDeletedMessageStore.add(transaction: transaction, message: KWGramDeletedMessage(
+                id: Int64.random(in: 1...Int64.max),
+                peerId: id.peerId,
+                authorId: author.id,
+                originalTimestamp: message.timestamp,
+                deletedAt: now,
+                textPreview: textPreview,
+                localMessageId: localMessageId
+            ))
+        }
+    }
+
+    private static func mediaPreview(_ media: Media) -> String {
+        switch media {
+        case is TelegramMediaImage:
+            return "Фото"
+        case let file as TelegramMediaFile:
+            if file.isVideo {
+                return "Видео"
+            } else if file.isVoice {
+                return "Голосовое сообщение"
+            } else if file.isSticker {
+                return "Стикер"
+            } else if file.isAnimated {
+                return "GIF"
+            }
+            return file.fileName ?? "Файл"
+        case is TelegramMediaContact:
+            return "Контакт"
+        case is TelegramMediaMap:
+            return "Геолокация"
+        case is TelegramMediaPoll:
+            return "Опрос"
+        default:
+            return "Сообщение"
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/KWGram/KWGramMuteDMFilter.swift b/submodules/TelegramCore/Sources/KWGram/KWGramMuteDMFilter.swift
new file mode 100644
index 00000000..e3944079
--- /dev/null
+++ b/submodules/TelegramCore/Sources/KWGram/KWGramMuteDMFilter.swift
@@ -0,0 +1,101 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+import KWGramCore
+
+/// «Мут ЛС» (KW Gram): drops incoming messages from muted private chats *before* they ever
+/// reach Postbox — the whole point of the feature is that a muted person's messages don't
+/// flash into the chat even for a frame. Called from `replayFinalState` in
+/// `AccountStateManagementUtils.swift` right before the single `transaction.addMessages`
+/// that applies every batch of incoming cloud messages (updates, getDifference, associated
+/// message resolution).
+///
+/// What happens to a dropped message:
+/// - it never enters Postbox → no history row, no chat-list preview, no in-app notification
+///   (`messagesForNotification` finds nothing for the id and skips it);
+/// - a `cloudChatRemoveMessages` operation is enqueued **in a separate, deferred
+///   transaction** (see below), so the always-running managed operation performs a real
+///   server-side `messages.deleteMessages` (revoke when «Удалять у всех» is on) — that is
+///   what keeps the message from coming back later through history/chat-list fetches.
+///
+/// Only messages *sent after* the mute started are dropped (`timestamp >= mutedAt`):
+/// history fetched later (replies, context resolution, hole fills routed through the same
+/// funnel) must keep pre-mute history intact, exactly like the Android `mute_ls` plugin,
+/// which only hooks message *arrival*.
+///
+/// ## Why the server-side delete is deferred (v1.5.0 regression, fixed in v1.6.0)
+///
+/// The first implementation enqueued `cloudChatAddRemoveMessagesOperation` **inside the
+/// `replayFinalState` transaction itself**. That is the one thing that must never happen
+/// there: `replayFinalState` runs as part of the account-state manager's `getDifference`
+/// application, and writing a peer operation-log entry from within it — plus the managed
+/// delete operation's out-of-band `updatePts` that follows — interleaves extra pts steps
+/// with the very difference loop that is mid-flight. With an active mute that loop can
+/// never settle: `AccountNetworkState` stays `.updating`, the chat-list header spins
+/// «Обновление» forever, and incoming messages stop being applied (while outgoing RPCs,
+/// which don't depend on it, keep working). The drop itself is pure and stays here; the
+/// delete is now issued from a *fresh* transaction scheduled after this one commits —
+/// exactly the context the normal "delete my message" UI action uses.
+///
+/// Lives in `TelegramCore` itself for the same reason as `KWGramDeletedMessageCapture`:
+/// it needs `Namespaces`, `StoreMessage` and the internal
+/// `cloudChatAddRemoveMessagesOperation`, and `KWGramCore` must never depend back on
+/// `TelegramCore`.
+enum KWGramMuteDMFilter {
+    /// Returns the messages that should actually be added; schedules server-side deletes for
+    /// the rest. Pure with respect to its inputs except for that deferred delete.
+    static func filterIncoming(transaction: Transaction, postbox: Postbox, accountPeerId: PeerId, messages: [StoreMessage]) -> [StoreMessage] {
+        // rawSettings: «Мут ЛС» — фича раздела «Чаты», её не должна гасить «Визуальная
+        // галка» (как и Gift Search, читаем raw).
+        let settings = KWGramCore.rawSettings(transaction: transaction)
+        guard settings.muteDmEnabled else {
+            return messages
+        }
+        let now = Int32(Date().timeIntervalSince1970)
+        let muted = KWGramMutedPeerStore.activeMutedAt(transaction: transaction, now: now)
+        guard !muted.isEmpty else {
+            return messages
+        }
+
+        var kept: [StoreMessage] = []
+        kept.reserveCapacity(messages.count)
+        var dropped: [PeerId: [MessageId]] = [:]
+
+        for message in messages {
+            guard message.flags.contains(.Incoming),
+                  case let .Id(id) = message.id,
+                  id.peerId.namespace == Namespaces.Peer.CloudUser,
+                  id.peerId != accountPeerId,
+                  let mutedAt = muted[id.peerId],
+                  message.timestamp >= mutedAt
+            else {
+                kept.append(message)
+                continue
+            }
+            dropped[id.peerId, default: []].append(id)
+        }
+
+        guard !dropped.isEmpty else {
+            return kept
+        }
+
+        let type: CloudChatRemoveMessagesType = settings.muteDmDeleteForEveryone ? .forEveryone : .forLocalPeer
+        // Отложенная свежая транзакция — вне replay. Постановка operation-log-записи внутри
+        // самой replay-транзакции была багом v1.5.0 (см. док сверху): pts-петля getDifference
+        // злипалась в вечное «Обновление», входящие перестали применяться.
+        Queue.concurrentDefaultQueue().async {
+            let _ = postbox.transaction { transaction -> Void in
+                for (peerId, ids) in dropped {
+                    cloudChatAddRemoveMessagesOperation(
+                        transaction: transaction,
+                        peerId: peerId,
+                        threadId: nil,
+                        messageIds: ids,
+                        type: type
+                    )
+                }
+            }.start()
+        }
+        return kept
+    }
+}
diff --git a/submodules/TelegramCore/Sources/KWGram/KWGramStateDiagnostics.swift b/submodules/TelegramCore/Sources/KWGram/KWGramStateDiagnostics.swift
new file mode 100644
index 00000000..977125d9
--- /dev/null
+++ b/submodules/TelegramCore/Sources/KWGram/KWGramStateDiagnostics.swift
@@ -0,0 +1,47 @@
+import Foundation
+import SwiftSignalKit
+
+/// Живой снимок ветвления `updates.getDifference`.
+///
+/// `AccountStateManager` в нескольких ветках не сбрасывает `currentIsUpdatingValue` и не
+/// применяет события вовсе: тогда шапка чат-листа навсегда показывает «Обновление...», а
+/// список остаётся пустым. Решения этих веток по умолчанию попадают только в
+/// `Logger.shared`, который с устройства прочитать нельзя, поэтому каждая ветка
+/// дублируется сюда.
+///
+/// Хранится ровно одно, последнее значение: порядок записей совпадает с порядком
+/// достижения шагов, поэтому снимок всегда показывает, на каком шаге пайплайн сейчас
+/// упирается.
+///
+/// В значение дополнительно включены порядковый номер записи и время — по одному
+/// статичному снимку нельзя отличить остановку пайплайна от быстрого цикла, который на
+/// каждом витке пишет ту же строку: номер перестаёт расти только в первом случае.
+public enum KWGramStateDiagnostics {
+    private static let promise = ValuePromise<String>("pollDifference ещё не запускался", ignoreRepeated: true)
+
+    private static let lock = NSLock()
+    private static var counter: Int = 0
+
+    private static let timeFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.dateFormat = "HH:mm:ss"
+        return formatter
+    }()
+
+    /// Текущее значение и все последующие — для живого вывода в интерфейсе.
+    public static var signal: Signal<String, NoError> {
+        return promise.get()
+    }
+
+    /// Записать шаг, на котором сейчас находится пайплайн состояния аккаунта.
+    public static func record(_ step: String) {
+        lock.lock()
+        counter += 1
+        let number = counter
+        lock.unlock()
+
+        let time = timeFormatter.string(from: Date())
+        promise.set("#\(number) \(time) · \(step)")
+    }
+}
