diff --git a/submodules/TelegramCore/Sources/State/KWGramGhostHelpers.swift b/submodules/TelegramCore/Sources/State/KWGramGhostHelpers.swift
new file mode 100644
index 00000000..5c272a73
--- /dev/null
+++ b/submodules/TelegramCore/Sources/State/KWGramGhostHelpers.swift
@@ -0,0 +1,89 @@
+import Foundation
+import Postbox
+import KWGramCore
+
+// KW Gram Ghost — shared, per-peer suppression decision for the granular "Режим призрака"
+// options. Lives inside TelegramCore (not the KWGramCore module) because deciding whether a
+// peer is exempt needs TelegramCore-only types — the peer's own class (channel vs group) and
+// the chat-folder state — which KWGramCore must not depend on. The pure part of the decision
+// (master toggle, per-feature toggle, the exception set) lives on `KWGramSettings`; this file
+// only resolves the TelegramCore-side inputs and hands them over.
+//
+// Every feature here withholds one of *this* account's own outgoing signals (read receipts,
+// story views, typing). Nothing reads or stores anyone else's data.
+
+enum KWGramGhostPeerFeature {
+    case readReceipts
+    case storyViews
+    case typing
+}
+
+/// Chat-folder ids whose explicitly-listed chats include this peer. Used only to honor the
+/// "Папки" exception; category-rule membership (e.g. a folder set to "all groups") isn't
+/// expanded — only chats the user added to the folder by hand count.
+func kwGramGhostFolderIds(transaction: Transaction, peerId: PeerId) -> [Int32] {
+    guard let filtersState = transaction.getPreferencesEntry(key: PreferencesKeys.chatListFilters)?.get(ChatListFiltersState.self) else {
+        return []
+    }
+    var result: [Int32] = []
+    for filter in filtersState.filters {
+        if case let .filter(id, _, _, data) = filter {
+            if data.includePeers.peers.contains(peerId) || data.includePeers.pinnedPeers.contains(peerId) {
+                result.append(id)
+            }
+        }
+    }
+    return result
+}
+
+/// Whether the given per-peer Ghost feature should suppress its outgoing signal for this peer,
+/// right now: master on, the feature on, "Читать при действиях" not already relaxing it for
+/// this chat, and the peer not covered by any exception.
+func kwGramGhostShouldSuppress(transaction: Transaction, peerId: PeerId, feature: KWGramGhostPeerFeature) -> Bool {
+    let settings = KWGramCore.settings(transaction: transaction)
+    guard settings.ghostModeEnabled else {
+        return false
+    }
+
+    let featureEnabled: Bool
+    switch feature {
+    case .readReceipts:
+        featureEnabled = settings.ghostHideReadReceipts
+    case .storyViews:
+        featureEnabled = settings.ghostHideStoryViews
+    case .typing:
+        featureEnabled = settings.ghostHideTyping
+    }
+    guard featureEnabled else {
+        return false
+    }
+
+    // "Читать при действиях" relaxes read receipts (only) for a chat once you've messaged in
+    // it this session — you've already revealed you're there, so hiding your reads stops
+    // helping. Other features are unaffected.
+    if case .readReceipts = feature, settings.ghostReadOnAction, KWGramGhostRuntime.shared.hasActed(peerId: peerId.toInt64()) {
+        return false
+    }
+
+    var isChannel = false
+    var isGroup = false
+    if let peer = transaction.getPeer(peerId) {
+        if let channel = peer as? TelegramChannel {
+            switch channel.info {
+            case .broadcast:
+                isChannel = true
+            case .group:
+                isGroup = true
+            }
+        } else if peer is TelegramGroup {
+            isGroup = true
+        }
+    }
+
+    let folderIds = kwGramGhostFolderIds(transaction: transaction, peerId: peerId)
+    if settings.ghostExcludesPeer(peerId: peerId, isChannel: isChannel, isGroup: isGroup, folderIds: folderIds) {
+        return false
+    }
+
+    return true
+}
